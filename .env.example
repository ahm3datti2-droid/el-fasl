# EL FASL — environment variables
# Copy to .env.local (never commit real keys). Without these the app runs in
# DEMO MODE: any email + password >= 6 chars signs in (admin@elfasl.app = admin).

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — server-side only, NEVER expose to the client.
# Only needed for future server-side XP awards / admin jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for email-confirmation + password-reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
